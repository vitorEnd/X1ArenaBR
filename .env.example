# URL pública do projeto (Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública/publishable. Pode ser enviada ao navegador; a RLS continua obrigatória.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_AQUI

# Somente servidor. Nunca use o prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_SUBSTITUA_AQUI

# IDs UUID do Supabase Auth separados por vírgula. Deixe vazio até definir o suporte.
SUPABASE_SUPPORT_USER_IDS=

# Origem exata do site, sem barra ao final. Em desenvolvimento use localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
